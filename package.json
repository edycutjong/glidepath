{
  "name": "glidepath",
  "version": "1.3.0",
  "private": true,
  "description": "Paste a token, a chain and the amount you hold. Glidepath turns it into a dated selling calendar sized to organic demand — Nansen labels decide what counts as organic.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "glidepath": "tsx packages/cli/src/cli.ts",
    "spike": "tsx scripts/spike.ts",
    "seed": "tsx scripts/seed.ts",
    "verify": "tsx scripts/verify.ts",
    "bench": "tsx scripts/bench.ts",
    "check": "tsx scripts/check_submission_readiness.ts",
    "dev": "npm run dev --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=high --omit=dev",
    "ci": "npm run audit && npm run format:check && npm run lint && npm run typecheck && npm run typecheck:web && npm run test:coverage && npm run verify && npm run check",
    "ci:full": "npm run ci && npm run build && npm run e2e",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lighthouse": "lhci autorun"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-check": "^4.10.1",
    "license-checker": "^25.0.1",
    "prettier": "^3.9.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "overrides": {
    "postcss": "^8.5.28",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "sharp": "^0.35.4"
  }
}
