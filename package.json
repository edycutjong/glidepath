{
  "name": "glidepath",
  "version": "1.0.0",
  "private": true,
  "description": "Paste a token, a chain and the amount you hold. Glidepath turns it into a dated selling calendar sized to organic demand — Nansen labels decide what counts as organic.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "glidepath": "tsx packages/cli/src/cli.ts",
    "spike": "tsx scripts/spike.ts",
    "seed": "tsx scripts/seed.ts",
    "verify": "tsx scripts/verify.ts",
    "bench": "tsx scripts/bench.ts",
    "check": "tsx scripts/check_submission_readiness.ts",
    "dev": "npm run dev --workspace apps/web",
    "build:web": "npm run build --workspace apps/web"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module"
}
