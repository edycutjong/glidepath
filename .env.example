# ── Nansen ───────────────────────────────────────────────────
# Get from: https://app.nansen.ai/api  (an nsn_… key; read server-side only — never shipped to the browser)
# Only the live steps need it. Without a key, `npm run verify` replays the 13 recorded plans offline.
NANSEN_API_KEY=nsn_your-key-here

# ── Optional ─────────────────────────────────────────────────
# Offline mode: serve every call from the disk cache / fixtures and never touch the network (what `npm run verify` sets).
# A cache miss throws instead of spending a credit. Leave unset for the product.
# NANSEN_OFFLINE=1
